<?xml version="1.0" encoding="utf-8"?>
<!--
    Sunshine Music tab pill.

    Structurally the same pill as bg_pill (white paper, ink border, fully rounded), but wrapped
    in an inset. TabLayout gives every tab the full strip width including its horizontal padding,
    so a bare pill drawable would make neighbouring pills touch edge to edge. The inset eats 4dp
    off each side to create the gap, while the tab keeps its full width as a touch target.

    Colours come from pill_surface / pill_stroke, so this follows values-night automatically:
    #201F19 with a #48473D border in dark.

    The radius is 16dp against a 32dp tab (app:tabMinHeight in fragment_viewpager.xml), so the
    corner radius is exactly half the height and the ends are true semicircles. A 100dp radius
    here clamps to the same 16dp, but only because the tab is short; write the real number so
    that raising tabMinHeight without touching this cannot silently turn it back into a stadium
    that reads as a rounded rectangle.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp"
    android:insetRight="4dp">

    <ripple android:color="?attr/colorPrimary">

        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/pill_surface" />
                <stroke
                    android:width="1dp"
                    android:color="@color/pill_stroke" />
                <corners android:radius="16dp" />
            </shape>
        </item>

    </ripple>

</inset>