<?xml version="1.0" encoding="utf-8"?>
<!--
    Sunshine Music pill: page-colour surface, foreground border, fully rounded ends.

    pill_surface / pill_stroke / pill_on are defined per mode in values/ and values-night/ as the
    two duotone colours, so the pill never introduces a third shade. The rows it sits on are also
    given an explicit margin, because the RecyclerView list has no vertical item decoration and
    pills would otherwise touch.

    The ripple is kept so the rows do not lose their touch feedback when they gain a background.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorPrimary">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/pill_stroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>

</ripple>
