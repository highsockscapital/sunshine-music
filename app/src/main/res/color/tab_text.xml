<?xml version="1.0" encoding="utf-8"?>
<!--
    Sunshine Music tab pill text.

    Every tab is the same flat pill, so selection is carried only by the label: full-strength
    foreground when selected, a dimmed foreground when not. No accent colour, no second shape.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:color="?attr/colorOnSurface"
        android:state_selected="true" />
    <item
        android:alpha="0.55"
        android:color="?attr/colorOnSurface" />
</selector>
