<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="30dp"
    android:paddingRight="22dp"
    android:paddingBottom="30dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/iconCard"
        style="@style/Widget.App.FlatCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:cardCornerRadius="128dp">

        <!-- Sunshine Music: shows the actual painted icon, and the tint is gone with it. app:tint
             collapses every opaque pixel to one colour, and in this painting the face and the
             hair are both opaque, so tinting turned the whole portrait into a single flat blob.
             The 92% adaptive foreground is used rather than the legacy bitmap because its mat is
             the painting's own paper, so it reads as the artwork with no frame. -->
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:srcCompat="@mipmap/ic_launcher_foreground" />

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp"
            tools:text="1.0.0.aaaaaa" />

        <TextView
            android:id="@+id/about_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>