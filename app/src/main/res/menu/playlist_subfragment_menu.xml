<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Sunshine Music: the batch "add these songs to a playlist" entry point for this playlist.
         Shown once selecting starts, which is why it is the action that toggles selection on the
         first tap and confirms the batch on the second.

         Deliberately an overflow item rather than an icon in the toolbar, and deliberately with
         no icon at all. As a pinned icon it was drawn with ic_playlist_play, which is three
         stacked bars and a play arrow and therefore reads as a sort or queue control. With no
         label either, nothing on screen said that tapping it began a selection. A plain titled
         overflow entry cannot be misread that way.

         Titled "Add songs to another playlist", not "Add to playlist". You are already inside a
         playlist when this shows, so the generic wording asked the question the user is standing
         in the middle of. -->
    <item
        android:id="@+id/add_to_playlist"
        android:title="@string/add_songs_to_another_playlist"
        app:showAsAction="never" />

    <item
        android:id="@+id/cancel_selection"
        android:icon="@drawable/ic_close"
        android:title="@android:string/cancel"
        android:visible="false"
        app:showAsAction="always" />

    <item
        android:id="@+id/edit"
        android:icon="@drawable/ic_edit"
        android:title="@string/dialog_edit_metadata"
        app:showAsAction="ifRoom" />
</menu>